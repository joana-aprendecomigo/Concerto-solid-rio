# Credenciais do Supabase — Project Settings → API
#
# Copiar para `.env` e preencher. Sem estes valores a plataforma arranca à
# mesma, mas guarda os dados só no browser (não são partilhados com a equipa).
#
# Usar SEMPRE a chave `anon` / `public`. A `service_role` dá acesso total e
# ignora todas as políticas de segurança — nunca a coloque aqui nem em código
# que corra no browser.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
